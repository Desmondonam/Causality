*.py[cod]
*$py.class
*.so
.Python
/env/
/venv/
/ENV/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints

# --- Data (DVC-tracked; regenerate with `python -m ml.data`) ---
*.csv
!data/.gitkeep

